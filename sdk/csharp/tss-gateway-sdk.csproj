<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>TSS.Gateway.Sdk</RootNamespace>
		<Version>1.0.0</Version>
		<DebugType>embedded</DebugType>
		<LangVersion>8.0</LangVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PackageId>TSS.Gateway.Sdk</PackageId>
		<Authors>Storytelling Company</Authors>
		<Description>Client SDK for the TSS gateway: publish requests, wait for events and run queries against a TSS player.</Description>
		<RepositoryUrl>https://github.com/PurpleNL/tss-play</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- The example integration is its own project; without this the SDK would compile its
		     sources into the package assembly. -->
		<Compile Remove="examples/**" />
	</ItemGroup>

	<ItemGroup>
		<!-- ProtoRoot makes imports resolve relative to the Protos folder itself, so the files
		     also compile standalone with protoc -I on a case-sensitive filesystem. -->
		<Protobuf Include="Protos\models.proto" GrpcServices="None" ProtoRoot="Protos" />
		<Protobuf Include="Protos\events.proto" GrpcServices="None" ProtoRoot="Protos" />
		<Protobuf Include="Protos\requests.proto" GrpcServices="None" ProtoRoot="Protos" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Tools" Version="2.69.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- The dll bytes differ per commit, checkout path and compiler version, so the Unity plugin is compared
	     on a fingerprint of the SDK sources instead. git hash-object makes it independent of line endings. -->
	<Target Name="ComputeSourceFingerprint" BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<_FingerprintInput Include="**\*.cs;Protos\**\*.proto;$(MSBuildProjectFile)" Exclude="bin\**;obj\**;examples\**" />
		</ItemGroup>
		<Exec
			Command="git hash-object -- @(_FingerprintInput->'&quot;%(Identity)&quot;', ' ')"
			WorkingDirectory="$(MSBuildProjectDirectory)"
			ConsoleToMSBuild="true"
			StandardOutputImportance="low"
			StandardErrorImportance="low"
			IgnoreExitCode="true"
			IgnoreStandardErrorWarningFormat="true">
			<Output TaskParameter="ConsoleOutput" ItemName="_FingerprintBlob" />
			<Output TaskParameter="ExitCode" PropertyName="_FingerprintExitCode" />
		</Exec>
		<WriteLinesToFile
			Condition="'$(_FingerprintExitCode)' == '0'"
			File="$(IntermediateOutputPath)source-fingerprint.txt"
			Lines="@(_FingerprintInput);@(_FingerprintBlob)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />
		<GetFileHash Condition="'$(_FingerprintExitCode)' == '0'" Files="$(IntermediateOutputPath)source-fingerprint.txt">
			<Output TaskParameter="Hash" PropertyName="SourceFingerprint" />
		</GetFileHash>
		<ItemGroup Condition="'$(SourceFingerprint)' != ''">
			<AssemblyMetadata Include="SourceFingerprint" Value="$(SourceFingerprint)" />
		</ItemGroup>
		<Message Condition="'$(SourceFingerprint)' == ''" Importance="high" Text="No SDK source fingerprint (git hash-object failed); the Unity plugin dll is always copied." />
	</Target>

	<Target Name="CopyToUnityPlugin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And '$(TargetFramework)' == 'netstandard2.1'">
		<PropertyGroup>
			<_UnityPluginDir>$(MSBuildProjectDirectory)\..\tss-play-unity\Assets\Plugins\</_UnityPluginDir>
			<_UnityPluginDll>$(_UnityPluginDir)$(TargetFileName)</_UnityPluginDll>
		</PropertyGroup>
		<Copy
			Condition="'$(SourceFingerprint)' == '' Or !Exists('$(_UnityPluginDll)') Or !$([System.IO.File]::ReadAllText('$(_UnityPluginDll)').Contains('$(SourceFingerprint)'))"
			SourceFiles="$(TargetPath)"
			DestinationFolder="$(_UnityPluginDir)" />
	</Target>

</Project>
