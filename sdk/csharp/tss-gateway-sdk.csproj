<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>TSS.Gateway.Sdk</RootNamespace>
		<Version>1.0.0</Version>
		<DebugType>embedded</DebugType>
		<LangVersion>8.0</LangVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PackageId>TSS.Gateway.Sdk</PackageId>
		<Authors>Storytelling Company</Authors>
		<Description>Client SDK for the TSS gateway: publish requests, wait for events and run queries against a TSS player.</Description>
		<RepositoryUrl>https://github.com/PurpleNL/tss-play</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- The tss-play-shared assembly is baked into this package instead of becoming a package
		     dependency, so its NuGet dependencies are declared here explicitly. -->
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSharedAssembly</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<!-- The example integration is its own project; without this the SDK would compile its
		     sources into the package assembly. -->
		<Compile Remove="examples/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
		<PackageReference Include="Google.Protobuf" Version="3.29.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\tss-play-shared\tss-play-shared.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<Target Name="IncludeSharedAssembly">
		<ItemGroup>
			<BuildOutputInPackage Include="$(OutputPath)tss-play-shared.dll" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
		<Exec
			Command="if exist &quot;$(TargetDir)..\netstandard2.1\$(TargetName).dll&quot; (&#xA;  xcopy &quot;$(TargetDir)..\netstandard2.1\$(TargetName).dll&quot; &quot;$(ProjectDir)..\tss-play-unity\Assets\Plugins\&quot; /Y&#xA;)" />
	</Target>

</Project>
